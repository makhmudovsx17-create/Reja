<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-/Compitable" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet"/>
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>Portfolio</title>
</head>

<body>
    <div class="frame">
        <div class="main_frame">
            <div class="left_frame">
                <div class="left_1">
                    <div class="left_1-1">
                        <img 
                        src="images/profile-image.png"
                        width="156px"
                        height="142px" 
                        alt="Profile image">
                    </div>
                    <div class="left_1-2">
                        <%=user.name%>
                    </div>
                    <div class="left_1-3">
                        <%=user.profession%>    
                    </div>
                    <div class="left_1-icons">
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Facebook.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Instagram.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Twitter.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Linkeding.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Youtube.svg" class="icon-1">
                            </div>
                        </a>
                        <a class="link_href" href="">
                            <div class="icon">
                                <img src="icon/Dribbble.svg" class="icon-1">
                            </div>
                        </a>
                    </div>
                </div>
                <div class="marginer"></div>

                <div class="left_2">
                    <div class="left_2-1"><span class="left_2-1-keys">Age:</span> <%=user.age%></div>
                    <div class="left_2-1"><span class="left_2-1-keys">Residence:</span> <%=user.residence%></div>
                    <div class="left_2-1"><span class="left_2-1-keys">Freelance:</span> <span class="green_text">Available</span></div>
                    <div class="left_2-1"><span class="left_2-1-keys">Address:</span> <%=user.adress%></div>
                </div>
                <div class="marginer"></div>

                <div class="left_3">
                    <h6>Languages</h6>
                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.languages[0] %></span>
                            <span>100%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 100%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.languages[1] %></span>
                            <span>80%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 80%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.languages[2] %></span>
                            <span>60%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 60%;"></div>
                        </div>
                    </div>
                </div>
                <div class="marginer"></div>

                <div class="left_4">
                    <h6>Skills</h6>
                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.skills [0] %></span>
                            <span>90%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 90%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.skills [1] %></span>
                            <span>85%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 85%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.skills [2] %></span>
                            <span>80%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 80%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.skills [3] %></span>
                            <span>75%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 75%;"></div>
                        </div>
                    </div>

                    <div class="lang-item">
                        <div class="lang-label">
                            <span><%= user.skills [4] %></span>
                            <span>85%</span>
                        </div>
                        <div class="lang-bar">
                            <div class="lang-fill" style="width: 85%;"></div>
                        </div>
                    </div>
                </div>
                <div class="marginer"></div>

                <div class="left_5">
                    <h6>Extra-skills</h6>
                    <div class="left_5-5">
                        <img src="/author/icon/icon.svg">
                        <%= user["extra-skills"][0] %>
                    </div>

                    <div class="left_5-5">
                        <img src="/author/icon/icon.svg">
                        <%= user["extra-skills"][1] %>
                    </div>

                    <div class="left_5-5">
                        <img src="/author/icon/icon.svg">
                        <%= user["extra-skills"][2] %>
                    </div>

                    <div class="left_5-5">
                        <img src="/author/icon/icon.svg">
                        <%= user["extra-skills"][3] %>
                    </div>
                </div>
                <div class="marginer"></div>
            </div>
            
            <div class="midd_frame">
                <section class="hero">
                    <span class="shape circle s1"></span>
                    <span class="shape circle s2"></span>
                    <span class="shape circle s3"></span>
                    <span class="shape diamond s4"></span>
                    <span class="shape diamond s5"></span>
                    <span class="shape circle s6"></span>
                    <svg class="shape s7" width="18" height="16" viewBox="0 0 18 16">
                        <polygon points="9,1 17,15 1,15" fill="none" stroke="#e2574c" stroke-width="2"/>
                    </svg>

                    <div class="hero-content">
                        <h1><%= user["work-place"] %></h1>                        
                        <p><%= user.about_me %></p>
                        <button class="btn-hire">HIRE ME &rarr;</button>
                    </div>

                    <div class="hero-image">
                        <img src="/author/images/middle-top_image.png" alt="Portrait">
                    </div>
                </section>

                <section class="services">
                    <div class="services-header">
                        <h2>My Services</h2>
                        <p><%= user["service-desc"] %></p>
                    </div>

                    <div class="services-grid">

                        <div class="service-card">
                            <div class="service-icon">
                                <img src="/author/icon/coding.svg">
                            </div>
                            <h3>Web Development</h3>
                            <p>Blog, E-Commerce</p>
                        </div>

                        <div class="service-card">
                            <div class="service-icon">
                                <img src="/author/icon/illustration.svg">
                            </div>
                            <h3>UI/UX Design</h3>
                            <p>Mobile App, Website Design</p>
                        </div>

                        <div class="service-card">
                            <div class="service-icon">
                                <img src="/author/icon/Microphone.svg">    
                            </div>
                            <h3>Sound Design</h3>
                            <p>Voice Over, Beat Making</p>
                        </div>

                        <div class="service-card">
                            <div class="service-icon">
                                <img src="/author/icon/game-development.svg">
                            </div>
                            <h3>Game Design</h3>
                            <p>Character Design, Props &amp; Objects</p>
                        </div>

                        <div class="service-card">
                            <div class="service-icon">
                                <img src="/author/icon/Photographer.svg">
                            </div>
                            <h3>Photography</h3>
                            <p>Portrait, Product Photography</p>
                        </div>

                        <div class="service-card advertising">
                            <h3>Advertising</h3>
                            <p>Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit. Vitae Nulla Diam In Ac Dictum A Urna Viverra Morbi.</p>
                            <a href="#" class="order-now">ORDER NOW &rsaquo;</a>
                        </div>

                    </div>
                </section>
            </div>
            
            <div class="right_frame">
                <button class="theme-toggle" title="Toggle theme">
                    <img src="/author/btn_icon/Contrast.svg" alt="">
                </button>

                <nav class="icon-nav">
                    <a href="#" class="icon-btn active">
                        <img src="/author/btn_icon/Home.svg" alt="Home">
                    </a>
                    <a href="#" class="icon-btn">
                        <img src="/author/btn_icon/Service.svg" alt="Code">
                    </a>
                    <a href="#" class="icon-btn">
                        <img src="/author/btn_icon/Cv.svg" alt="Education">
                    </a>
                    <a href="#" class="icon-btn">
                        <img src="/author/btn_icon/Portfolio.svg" alt="Work">
                    </a>
                    <a href="#" class="icon-btn">
                        <img src="/author/btn_icon/Blog.svg" alt="Projects">
                    </a>
                    <a href="#" class="icon-btn">
                        <img src="/author/btn_icon/Contact.svg" alt="Contact">
                    </a>
                </nav>

            </div>
        </div>
    </div>   
</body>

</html>